# Database & Redis (docker compose up)
DATABASE_URL="postgresql://chiketto:chiketto@localhost:5434/chiketto"
TEST_DATABASE_URL="postgresql://chiketto:chiketto@localhost:5434/chiketto_test"
REDIS_URL="redis://localhost:6379"

# Aplikasi
APP_URL="http://localhost:3100"
AUTH_SECRET="ganti-dengan-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
QR_SECRET="ganti-dengan-string-acak-panjang"

# Login Google (opsional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Akun demo tiga peran (matikan di produksi sungguhan)
DEMO_LOGIN=true

# Email: isi RESEND_API_KEY untuk Resend, kosongkan untuk SMTP (Mailpit di dev)
EMAIL_FROM="Chiketto <tiket@chiketto.local>"
RESEND_API_KEY=""
SMTP_HOST="localhost"
SMTP_PORT=1025

# Midtrans Snap (sandbox)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
# Tanpa kunci Midtrans: tampilkan tombol simulasi bayar (hanya non-produksi)
PAYMENT_MOCK=true

# Upload poster: isi Cloudinary, atau kosongkan untuk simpan lokal di .uploads/
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
